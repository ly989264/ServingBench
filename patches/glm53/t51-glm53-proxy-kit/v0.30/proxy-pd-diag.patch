+# ---- P/D diagnostics: one line per request, off unless PD_PROXY_DIAG=1 ----------------------------------------------
+#
+# PD_PROXY_DIAG=1: the proxy makes its own request id for every request (sent to P and D as X-Request-Id and as the
+# body's request_id; a client's id is kept as client_request_id) and writes one [PD_DIAG] line per request when the
+# request ends: six times on the proxy's monotonic clock (request received, before the request to P, P's response,
+# before the request to D, D's first chunk, end), the retries, stream / include_usage / n, and the P and D addresses
+# of the first attempt. Unset or any other value: none of this runs and the proxy behaves as without it.
+#
+# Files: <PD_PROXY_DIAG_DIR>/proxy-<port>/proxy.<start time>.<pid>.<seq>.log (default directory /var/log/pd-diag-proxy),
+# one per uvicorn worker process, named like the panel-2 node files: a file larger than PD_PROXY_DIAG_ROTATE_MIB (256)
+# is closed and a new name is opened, files are never renamed, files older than PD_PROXY_DIAG_KEEP_HOURS (12) are
+# deleted unless another live worker may still be writing them. The first line of a file names it (pd_file_open); a
+# self-check line with the counts follows every PD_PROXY_DIAG_SELFCHECK_S seconds (60). The event loop only puts a
+# finished record on a bounded queue (PD_PROXY_DIAG_QUEUE lines, 10000); a writer thread does all file work. When the
+# queue is full the record is dropped and counted.
+
+_PD_DIAG = os.environ.get("PD_PROXY_DIAG", "") == "1"
+_PD_FILE_RE = re.compile(r"^proxy\.\d{8}T\d{6}\.(\d+)\.\d{4}\.log$")
+
+
+def _pd_pid_running(pid: int) -> bool:
+    if pid <= 0:
+        return False
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except OSError:
+        return True  # e.g. a process of another user: it exists
+    return True
+
+
+def _pd_iso_time(seconds: float) -> str:
+    """Wall time with milliseconds and the local UTC offset, e.g. 2026-11-11T09:30:01.123+08:00 (as on the nodes)."""
+    local = time.localtime(seconds)
+    offset = local.tm_gmtoff if hasattr(local, "tm_gmtoff") else -time.timezone
+    sign = "+" if offset >= 0 else "-"
+    offset = abs(int(offset))
+    ms = int((seconds - int(seconds)) * 1000)
+    return f"{time.strftime('%Y-%m-%dT%H:%M:%S', local)}.{ms:03d}{sign}{offset // 3600:02d}:{(offset % 3600) // 60:02d}"
+
+
+def _pd_ms(start: int | None, end: int | None) -> float | None:
+    if start is None or end is None:
+        return None
+    return round((end - start) / 1e6, 3)
+
+
+class _PdWriter:
+    """Writes this process's records from a thread of its own (see the block comment above)."""
+
+    def __init__(self, port: int):
+        env = os.environ
+        self.pid = os.getpid()
+        self.instance = f"proxy-{port}"
+        self.dir = os.path.join(env.get("PD_PROXY_DIAG_DIR") or "/var/log/pd-diag-proxy", self.instance)
+        self.rotate_bytes = int(float(env.get("PD_PROXY_DIAG_ROTATE_MIB") or 256) * 1024 * 1024)
+        self.keep_s = float(env.get("PD_PROXY_DIAG_KEEP_HOURS") or 12) * 3600
+        self.selfcheck_s = float(env.get("PD_PROXY_DIAG_SELFCHECK_S") or 60)
+        self.queue: queue.Queue = queue.Queue(maxsize=int(env.get("PD_PROXY_DIAG_QUEUE") or 10000))
+        self.started = time.time()
+        self.start = time.strftime("%Y%m%dT%H%M%S", time.localtime(self.started))
+        self.host = socket.gethostname()
+        # queued and queue_full are counted on the event loop, the rest on the writer thread.
+        self.counts = {"queued": 0, "queue_full": 0, "written": 0, "errors": 0}
+        self.last_error = None
+        self.seq = -1
+        self.fh = None
+        self.path = None
+        self.bytes = 0
+        self.lock = threading.Lock()
+        threading.Thread(target=self._run, name="pd-proxy-diag", daemon=True).start()
+        atexit.register(self.drain)
+
+    def put(self, row: dict) -> None:
+        try:
+            self.queue.put_nowait(row)
+            self.counts["queued"] += 1
+        except queue.Full:
+            self.counts["queue_full"] += 1
+
+    def _line(self, row: dict) -> bytes:
+        payload = json.dumps(row, ensure_ascii=False, separators=(",", ":"))
+        return (
+            f"{_pd_iso_time(time.time())} (proxy pid={self.pid}) INFO "
+            f"[load_balance_proxy_server_example.py:0] [PD_DIAG] {payload}\n"
+        ).encode("utf-8", "replace")
+
+    def _open(self) -> None:
+        if self.fh is not None:
+            with contextlib.suppress(Exception):
+                self.fh.close()
+        os.makedirs(self.dir, exist_ok=True)
+        self.seq += 1
+        self.path = os.path.join(self.dir, f"proxy.{self.start}.{self.pid}.{self.seq:04d}.log")
+        # Kept open for appending until the next rotation; closed by _open() or at exit.
+        self.fh = open(self.path, "ab", buffering=1024 * 1024)  # noqa: SIM115
+        self.bytes = self.fh.tell()
+        head = {
+            "event": "pd_file_open",
+            "version": 1,
+            "instance": self.instance,
+            "host": self.host,
+            "pid": self.pid,
+            "role": "proxy",
+            "file": os.path.basename(self.path),
+            "seq": self.seq,
+            "timestamp_ns": time.monotonic_ns(),
+        }
+        data = self._line(head)
+        self.fh.write(data)
+        self.bytes += len(data)
+
+    def _write(self, row: dict) -> None:
+        if self.fh is None or self.bytes >= self.rotate_bytes:
+            self._open()
+        data = self._line(row)
+        self.fh.write(data)
+        self.bytes += len(data)
+
+    def _selfcheck(self) -> None:
+        row = dict(self.counts)
+        row.update(
+            event="pd_proxy_selfcheck",
+            version=1,
+            instance=self.instance,
+            host=self.host,
+            pid=self.pid,
+            queue_len=self.queue.qsize(),
+            last_error=self.last_error,
+            file=os.path.basename(self.path) if self.path else None,
+            python=sys.version.split()[0],
+            timestamp_ns=time.monotonic_ns(),
+        )
+        self._write(row)
+
+    def _clean_old(self) -> None:
+        """Deletes files older than keep_hours, but never a file another live worker may still be writing.
+
+        Another worker's file is deleted only when the pid in its name is no longer running, or when it
+        was last written before this process started.
+        """
+        cutoff = time.time() - self.keep_s
+        try:
+            names = os.listdir(self.dir)
+        except OSError:
+            return
+        for name in names:
+            path = os.path.join(self.dir, name)
+            m = _PD_FILE_RE.match(name)
+            if path == self.path or not m:
+                continue
+            try:
+                mtime = os.stat(path).st_mtime
+                if mtime >= cutoff:
+                    continue
+                pid = int(m.group(1))
+                if pid == self.pid or mtime < self.started or not _pd_pid_running(pid):
+                    os.unlink(path)
+            except OSError:
+                pass
+
+    def _error(self, exc: BaseException) -> None:
+        self.counts["errors"] += 1
+        self.last_error = f"{type(exc).__name__}: {str(exc)[:200]}"
+
+    def _run(self) -> None:
+        next_check = time.monotonic() + self.selfcheck_s
+        next_clean = time.monotonic() + 60
+        while True:
+            try:
+                row = self.queue.get(timeout=1.0)
+            except queue.Empty:
+                row = None
+            with self.lock:
+                try:
+                    if row is not None:
+                        self._write(row)
+                        self.counts["written"] += 1
+                    now = time.monotonic()
+                    if now >= next_check:
+                        next_check = now + self.selfcheck_s
+                        self._selfcheck()
+                    if now >= next_clean:
+                        next_clean = now + 600
+                        self._clean_old()
+                    if self.fh is not None and self.queue.empty():
+                        self.fh.flush()
+                except Exception as exc:
+                    self._error(exc)
+
+    def drain(self) -> None:
+        """At exit: writes what is still queued, then a last self-check line."""
+        with self.lock:
+            try:
+                while True:
+                    try:
+                        row = self.queue.get_nowait()
+                    except queue.Empty:
+                        break
+                    self._write(row)
+                    self.counts["written"] += 1
+                self._selfcheck()
+                self.fh.flush()
+            except Exception as exc:
+                self._error(exc)
+
+
+_pd_writer_obj: _PdWriter | None = None
+
+
+def _pd_writer() -> _PdWriter:
+    global _pd_writer_obj
+    if _pd_writer_obj is None or _pd_writer_obj.pid != os.getpid():
+        _pd_writer_obj = _PdWriter(get_global_args().port)
+    return _pd_writer_obj
+
