+class _PdRecord:
+    """One request as the proxy sees it. Times are time.monotonic_ns(); each is taken once, so with retries the
+    P and D times and addresses are those of the first attempt, and d_total runs from the first request to D to
+    the end."""
+
+    def __init__(self, api: str):
+        self.t_enter = time.monotonic_ns()
+        self.wall_start_ns = time.time_ns()
+        self.api = api
+        self.request_id: str | None = None
+        self.client_request_id: str | None = None
+        self.stream = None
+        self.include_usage = None
+        self.n = None
+        self.p_addr: str | None = None
+        self.d_addr: str | None = None
+        self.t_p_send: int | None = None
+        self.t_p_return: int | None = None
+        self.t_d_send: int | None = None
+        self.t_d_first: int | None = None
+        self.p_http_retries = 0
+        self.d_http_retries = 0
+        self.recompute_retries = 0
+        self.retry_ns = 0
+        self.status = "ok"
+        self.http_status: int | None = None
+        self.interrupted = False
+        self.done = False
+
+    def start(self, req_data: dict) -> None:
+        """Called once the request id the original code would use is in req_data: keeps it as the client's id and
+        puts the proxy's own id in its place."""
+        cid = req_data.get("request_id")
+        self.client_request_id = str(cid) if cid not in (None, "") else None
+        self.request_id = next_req_id()
+        req_data["request_id"] = self.request_id
+        self.stream = bool(req_data.get("stream", False))
+        options = req_data.get("stream_options")
+        self.include_usage = options.get("include_usage") if isinstance(options, dict) else None
+        self.n = req_data.get("n")
+
+    def on_p_send(self, attempt: int) -> None:
+        if self.t_p_send is None:
+            self.t_p_send = time.monotonic_ns()
+        if attempt > 1:
+            self.p_http_retries += 1
+
+    def on_p_return(self) -> None:
+        if self.t_p_return is None:
+            self.t_p_return = time.monotonic_ns()
+
+    def on_instances(self, prefiller: dict, decoder: dict) -> None:
+        if self.p_addr is None:
+            self.p_addr = f"{prefiller.get('host')}:{prefiller.get('port')}"
+            self.d_addr = f"{decoder.get('host')}:{decoder.get('port')}"
+
+    def on_d_send(self, attempt: int) -> None:
+        if self.t_d_send is None:
+            self.t_d_send = time.monotonic_ns()
+        if attempt > 1:
+            self.d_http_retries += 1
+
+    def on_d_first(self) -> None:
+        if self.t_d_first is None:
+            self.t_d_first = time.monotonic_ns()
+
+    def end(self, status: str | None = None, http_status: int | None = None) -> None:
+        if self.done:
+            return
+        self.done = True
+        t_end = time.monotonic_ns()
+        try:
+            if status is not None:
+                self.status = status
+            elif self.interrupted and self.status == "ok":
+                self.status = "error"
+            if http_status is not None:
+                self.http_status = http_status
+            retries = self.p_http_retries + self.d_http_retries + self.recompute_retries
+            row = {
+                "event": "pd_proxy_request",
+                "version": 1,
+                "request_id": self.request_id,
+                "client_request_id": self.client_request_id,
+                "api": self.api,
+                "status": self.status,
+                "http_status": self.http_status,
+                "stream": self.stream,
+                "include_usage": self.include_usage,
+                "n": self.n,
+                "p_addr": self.p_addr,
+                "d_addr": self.d_addr,
+                "retries": retries,
+                "recompute_retries": self.recompute_retries,
+                "p_http_retries": self.p_http_retries,
+                "d_http_retries": self.d_http_retries,
+                "retry_ms": round(self.retry_ns / 1e6, 3) if self.recompute_retries else None,
+                "api_gateway_ms": None,
+                "proxy_to_p_ms": _pd_ms(self.t_enter, self.t_p_send),
+                "p_total_ms": _pd_ms(self.t_p_send, self.t_p_return),
+                "proxy_to_d_ms": _pd_ms(self.t_p_return, self.t_d_send),
+                "d_first_ms": _pd_ms(self.t_d_send, self.t_d_first),
+                "d_total_ms": _pd_ms(self.t_d_send, t_end),
+                "ttft_ms": _pd_ms(self.t_enter, self.t_d_first),
+                "e2e_ms": _pd_ms(self.t_enter, t_end),
+                "t_enter_ns": self.t_enter,
+                "t_p_send_ns": self.t_p_send,
+                "t_p_return_ns": self.t_p_return,
+                "t_d_send_ns": self.t_d_send,
+                "t_d_first_ns": self.t_d_first,
+                "t_end_ns": t_end,
+                "wall_start_ns": self.wall_start_ns,
+                "pid": os.getpid(),
+                "timestamp_ns": t_end,
+            }
+            _pd_writer().put(row)
+        except Exception:
+            pass
+
