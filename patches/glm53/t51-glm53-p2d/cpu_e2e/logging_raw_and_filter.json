{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "vllm": {"()": "pd_diag_logfilter.VllmTextFormatter", "datefmt": "%m-%d %H:%M:%S"}
  },
  "handlers": {
    "console": {"class": "logging.StreamHandler", "formatter": "vllm", "level": "INFO", "stream": "ext://sys.stdout"},
    "pd_diag": {"()": "pd_diag_logfilter.PdDiagHandler", "level": "INFO"}
  },
  "loggers": {
    "vllm": {"handlers": ["console", "pd_diag"], "level": "INFO", "propagate": false}
  }
}
