# Test image as close to the glm5.3 site as a CPU container gets: Python 3.11.10 (site 3.11.10),
# transformers 5.14.1 (site 5.14.1), torch 2.10.0 CPU build (site torch 2.10.0a0 + torch_npu 2.10.0.post4),
# and vLLM v0.30.0's own requirements/common.txt. Packages from the Tsinghua PyPI mirror; torch from the
# PyTorch CPU index (the PyPI aarch64 torch wheels pull CUDA libraries).
FROM python:3.11.10-slim
ARG TORCH=2.10.0
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple PIP_DEFAULT_TIMEOUT=180 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN sed -i 's|http://deb.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources && apt-get update >/dev/null && apt-get install -y --no-install-recommends git gcc g++ >/dev/null && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv && /opt/venv/bin/pip install -q -U pip
RUN /opt/venv/bin/pip install --index-url https://download.pytorch.org/whl/cpu "torch==${TORCH}+cpu" && echo "torch==${TORCH}+cpu" > /opt/constraints.txt
COPY common-v0.30.0.txt /tmp/common.txt
RUN /opt/venv/bin/pip install -c /opt/constraints.txt -r /tmp/common.txt "transformers==5.14.1"
RUN /opt/venv/bin/pip install -c /opt/constraints.txt pytest pytest-asyncio tblib pytest-mock pytest-timeout setuptools-scm setuptools-rust wheel httpx
# v0.30.0's [build-system] needs setuptools>=77.0.3,<81 (the venv ships 65.5.0, too old for its license field)
RUN /opt/venv/bin/pip install -c /opt/constraints.txt "setuptools>=77.0.3,<81.0.0"
RUN /opt/venv/bin/pip list > /opt/pip-list.txt
