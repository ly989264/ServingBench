+                name,
+                {
+                    "calls": 0,
+                    "duration_ns": 0,
+                    "start_ns": None,
+                    "end_ns": None,
+                    "status": status,
+                    "exceptions": 0,
+                    "measured_calls": 0,
+                    "skipped_calls": 0,
+                    "unmeasured_calls": 0,
+                },
+            )
+            count = calls if _number(calls) else 1
