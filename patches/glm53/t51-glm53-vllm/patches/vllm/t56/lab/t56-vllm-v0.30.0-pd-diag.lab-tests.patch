+def test_startup_scheduler_line_reads_ascend_switches(caplog, monkeypatch):
+    import sys
+    import types
+
+    import vllm.v1.engine.core as core_mod
+
+    caplog.set_level(logging.INFO, logger=core_mod.__name__)
+    flag = lambda value: SimpleNamespace(enabled=value)  # noqa: E731
+    config = SimpleNamespace(scheduler_config=SimpleNamespace(
+        enable_balance_scheduling=False, recompute_scheduler_enable=True, dyntra_lb_config=flag(False),
+        batch_job_sched_config=flag(False), profiling_chunk_config=SimpleNamespace(),  # no 'enabled' -> '?'
+    ))
+    module = types.ModuleType("vllm_ascend.ascend_config")
+    module.get_ascend_config = lambda: config
+    monkeypatch.setitem(sys.modules, "vllm_ascend.ascend_config", module)
+
+    class RecomputeScheduler:
+        pass
+
+    RecomputeScheduler.__module__ = "vllm_ascend.core.recompute_scheduler"
+    RecomputeScheduler.__qualname__ = "RecomputeScheduler"
+    monkeypatch.setattr(core_mod, "_PD_STARTUP_LOGGED", False)
+    core_mod._pd_startup_log_scheduler(RecomputeScheduler())
+    # An uninitialized vllm-ascend config raises: every switch is '?', nothing propagates.
+    module.get_ascend_config = lambda: (_ for _ in ()).throw(RuntimeError("not initialized"))
+    monkeypatch.setattr(core_mod, "_PD_STARTUP_LOGGED", False)
+    core_mod._pd_startup_log_scheduler(RecomputeScheduler())
+    assert startup_lines(caplog) == [
+        "PD_DIAG_STARTUP scheduler=vllm_ascend.core.recompute_scheduler.RecomputeScheduler balance=False "
+        "recompute=True dyntra_lb=False batch_job=False profiling_chunk=?",
+        "PD_DIAG_STARTUP scheduler=vllm_ascend.core.recompute_scheduler.RecomputeScheduler balance=? "
+        "recompute=? dyntra_lb=? batch_job=? profiling_chunk=?",
+    ]
