+def test_startup_worker_timing_line_after_first_real_step(caplog, monkeypatch):
+    """The second Worker line comes once, after the first execute_model that decided the device timing."""
+    import vllm.v1.worker.worker_base as wb
+
+    caplog.set_level(logging.INFO, logger=wb.__name__)
+    monkeypatch.setattr(wb, "_PD_STARTUP_TIMING_LOGGED", False)
+    monkeypatch.setattr(wb, "pd_execution_context", lambda worker, out: {"tp_rank": 0, "execution_id": "x"})
+    runner = SimpleNamespace()
+    steps = []
+
+    def execute_model(scheduler_output):
+        steps.append(scheduler_output)
+        if len(steps) == 1:
+            raise RuntimeError("first step fails")
+        if scheduler_output.total_num_scheduled_tokens:
+            runner._pd_device_timing = SimpleNamespace(enabled=True)  # vllm-ascend decides it here
+        return "out"
+
+    wrapper = wb.WorkerWrapperBase.__new__(wb.WorkerWrapperBase)
+    wrapper.worker = SimpleNamespace(model_runner=runner, execute_model=execute_model)
+    wrapper.mm_receiver_cache = None
+    forward, no_forward = SimpleNamespace(total_num_scheduled_tokens=5), SimpleNamespace(total_num_scheduled_tokens=0)
+    try:
+        wrapper.execute_model(forward)
+    except RuntimeError:
+        pass
+    assert wrapper.execute_model(no_forward) == "out"  # undecided and no forward: does not count
+    assert startup_lines(caplog) == []
+    assert wrapper.execute_model(forward) == "out"
+    assert wrapper.execute_model(forward) == "out"
+    assert startup_lines(caplog) == ["PD_DIAG_STARTUP worker device_timing=on tp_rank=0"]
+
