+@pytest.mark.parametrize("after_send_error", [None, "coordinator", "output"])
+def test_zmq_completion_excludes_coordinator_and_output_work(
+    api, monkeypatch, dp, pending, after_send_error
+):
+    if after_send_error == "coordinator" and not dp:
+        pytest.skip("Only DP notifies the coordinator")
+    now = [100]
+    monkeypatch.setattr(api.diag, "time", SimpleNamespace(monotonic_ns=lambda: now[0]))
+    events = []
+    failure = RuntimeError("later submission work")
+    boundary = {
+        **api.diag.clock_domain(),
+        "boundary_id": "actual-send",
+        "end_ns": 20,
+        "status": "ok",
+    }
+    original = dict(boundary)
+    engine = api.engine.AsyncLLM.__new__(api.engine.AsyncLLM)
+    client = core_sender(api, None)
+    owner = api.diag.Batch("api_summary")
+
+    async def run():
+        future = asyncio.get_running_loop().create_future()
+
+        def finish_send():
+            now[0] = 130
+            events.append("send_done")
+            future.set_result(None)
+
+        def send(message, **kwargs):
+            assert message[0:2] == (b"engine", b"add")
+            assert message[-1].pd_tokenization == original
+            assert kwargs == {"copy": False}
+            events.append("send")
+            if pending:
+                asyncio.get_running_loop().call_soon(finish_send)
+            else:
+                finish_send()
+            return future
+
+        async def coordinator(message):
+            assert message == ("FIRST_REQ", b"engine")
+            events.append("coordinator")
+            while not future.done():
+                await asyncio.sleep(0)
+            await asyncio.sleep(0)
+            now[0] = 1000
+            if after_send_error == "coordinator":
+                raise failure
+
+        def output():
+            events.append("output")
+            now[0] = 2000
+            if after_send_error == "output":
+                raise failure
+
+        client.input_socket.send_multipart = send
+        client._ensure_output_queue_task = output
+        if dp:
+            client.current_wave = 0
+            client.engines_running = False
+            client._ensure_stats_update_task = lambda: events.append("stats")
+            client.get_core_engine_for_request = lambda request: b"engine"
+            client.first_req_send_socket = SimpleNamespace(send=coordinator)
+            client.add_request_async = (
+                lambda request: api.core.DPAsyncMPClient.add_request_async(client, request)
+            )
+        engine.engine_core = client
+        request = SimpleNamespace(request_id="actual-send", pd_tokenization=boundary)
+        if after_send_error:
+            with pytest.raises(RuntimeError) as caught:
+                await engine._send_engine_request(request, owner)
+            assert caught.value is failure
+        else:
+            await engine._send_engine_request(request, owner)
+        assert api.diag.current_add_request_send() is None
+
+    asyncio.run(run())
+    stage = owner.stages["add_request"]
+    assert stage["end_ns"] == 130 and stage["duration_ns"] == 110
+    assert stage["status"] == "ok" and stage["exceptions"] == 0
+    assert stage["send_completed"] is True
+    assert boundary == original
+    if dp:
+        assert events[:2] == ["stats", "send"]
+        if after_send_error != "coordinator":
+            assert events.index("coordinator") < events.index("output")
+    assert ("output" in events) == (after_send_error != "coordinator")
+
+
+@pytest.mark.parametrize("phase", ["encode", "send", "cancel", "unobserved"])
+def test_unsuccessful_send_never_reports_success(api, monkeypatch, phase):
+    now = [100]
+    monkeypatch.setattr(api.diag, "time", SimpleNamespace(monotonic_ns=lambda: now[0]))
+    failure = ValueError("send failed")
+    engine = api.engine.AsyncLLM.__new__(api.engine.AsyncLLM)
+    client = core_sender(api, None)
+    owner = api.diag.Batch("api_summary")
+    request = SimpleNamespace(
+        request_id="failed",
+        pd_tokenization={**api.diag.clock_domain(), "end_ns": 20, "status": "ok"},
+    )
+
+    async def run():
+        future = asyncio.get_running_loop().create_future()
+        now[0] = 130
+        if phase == "cancel":
+            future.cancel()
+        elif phase == "send":
+            future.set_exception(failure)
+        else:
+            future.set_result(None)
+        client.input_socket.send_multipart = lambda *args, **kwargs: future
+        if phase == "encode":
+            def fail(request):
+                raise failure
+
+            client.encoder.encode = fail
+        if phase == "unobserved":
+            async def unobserved(request):
+                return None
+
+            client.add_request_async = unobserved
+        engine.engine_core = client
+        if phase == "unobserved":
+            await engine._send_engine_request(request, owner)
+        else:
+            error = asyncio.CancelledError if phase == "cancel" else ValueError
+            with pytest.raises(error) as caught:
+                await engine._send_engine_request(request, owner)
+            if phase != "cancel":
+                assert caught.value is failure
+
+    asyncio.run(run())
+    stage = owner.stages["add_request"]
+    assert stage["send_completed"] is False
+    assert stage["status"] == (
+        "missing" if phase == "unobserved" else "cancelled" if phase == "cancel" else "error"
+    )
+    assert stage["duration_ns"] == (None if phase == "unobserved" else 110)
+    assert ("without_send" in stage["timing_scope"]) == (phase in ("encode", "unobserved"))
+
+
+def test_uninstrumented_add_and_other_messages_do_not_allocate_observer(api, monkeypatch):
+    def forbidden():
+        raise AssertionError("Unexpected ADD instrumentation")
+
+    monkeypatch.setattr(api.diag, "track_add_request_send", forbidden)
+    engine = api.engine.AsyncLLM.__new__(api.engine.AsyncLLM)
+    client = core_sender(api, None)
+    engine.engine_core = client
+
+    async def run():
+        future = asyncio.get_running_loop().create_future()
+        future.set_result(None)
+        client.input_socket.send_multipart = lambda *args, **kwargs: future
+        await engine._send_engine_request(SimpleNamespace(request_id="plain"), None)
+        monkeypatch.setattr(api.diag, "current_add_request_send", forbidden)
+        assert client._send_input(api.core.EngineCoreRequestType.ABORT, ["plain"]) is future
+
+    asyncio.run(run())
+
+
+@pytest.mark.parametrize("resolution", ["ok", "error", "cancel", "pending"])
+def test_dp_cancellation_preserves_send_state_and_detaches_pending_observer(
+    api, monkeypatch, resolution
+):
+    now = [100]
+    monkeypatch.setattr(api.diag, "time", SimpleNamespace(monotonic_ns=lambda: now[0]))
+    engine = api.engine.AsyncLLM.__new__(api.engine.AsyncLLM)
+    client = core_sender(api, None)
+    owner = api.diag.Batch("api_summary")
+    cancellation = asyncio.CancelledError("coordinator cancelled")
+    send_error = ValueError("ADD failed")
+
+    async def run():
+        future = asyncio.get_running_loop().create_future()
+        client.input_socket.send_multipart = lambda *args, **kwargs: future
+
+        async def coordinator(message):
+            now[0] = 130
+            if resolution == "ok":
+                future.set_result(None)
+            elif resolution == "error":
+                future.set_exception(send_error)
+            elif resolution == "cancel":
+                future.cancel()
+            await asyncio.sleep(0)
+            now[0] = 1000
+            raise cancellation
+
+        def output():
+            raise AssertionError("Output work must stay after coordinator await")
+
+        client._ensure_output_queue_task = output
+        client.current_wave = 0
+        client.engines_running = False
+        client._ensure_stats_update_task = lambda: None
+        client.get_core_engine_for_request = lambda request: b"engine"
+        client.first_req_send_socket = SimpleNamespace(send=coordinator)
+        client.add_request_async = (
+            lambda request: api.core.DPAsyncMPClient.add_request_async(client, request)
+        )
+        engine.engine_core = client
+        with pytest.raises(asyncio.CancelledError) as caught:
+            await engine._send_engine_request(
+                SimpleNamespace(
+                    request_id="dp-cancel",
+                    pd_tokenization={
+                        **api.diag.clock_domain(), "end_ns": 20, "status": "ok"
+                    },
+                ),
+                owner,
+            )
+        assert caught.value is cancellation
+        assert not future.cancelled() if resolution == "pending" else True
+        stage_before = dict(owner.stages["add_request"])
+        if resolution == "pending":
+            future.set_result(None)
+            now[0] = 5000
+            await asyncio.sleep(0)
+            assert owner.stages["add_request"] == stage_before
+        assert api.diag.current_add_request_send() is None
+
+    asyncio.run(run())
+    stage = owner.stages["add_request"]
+    assert stage["status"] == {
+        "ok": "ok", "error": "error", "cancel": "cancelled", "pending": "cancelled"
+    }[resolution]
+    assert stage["end_ns"] == (1000 if resolution == "pending" else 130)
+    assert stage["send_completed"] == (resolution == "ok")
