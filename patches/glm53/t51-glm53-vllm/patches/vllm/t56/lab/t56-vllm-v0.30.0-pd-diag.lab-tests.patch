+def test_unproved_or_real_add_request_missing_and_failure_stay_visible(synthetic, case):
+    _, original, _ = synthetic
+    records = json.loads(json.dumps([
+        record for record in original
+        if record["event"] == "api_summary" and record.get("observation_id") == "http-P"
+    ]))
+    request = next(record for record in records if record["scope"] == "request")
+    owner = next(record for record in records if record["scope"] == "engine_submission")
+    request["stages"]["add_request"] = legacy_add_request()
+    if case == "missing_only":
+        records.remove(owner)
+    elif case == "wrong_submission":
+        request["submission_id"] = "unrelated"
+    elif case == "foreign_process":
+        owner["pid"] += 1
+    elif case == "wrong_observation":
+        owner["observation_id"] = "other-lifecycle"
+    elif case == "wrong_request":
+        owner["links"] = [{"kind": "engine_request", "request_id": "other-request"}]
+    elif case == "ambiguous_owner":
+        duplicate = json.loads(json.dumps(owner))
+        duplicate["record_id"] += "-conflict"
+        records.append(duplicate)
+    elif case == "genuine_missing":
+        request["stages"]["add_request"]["reason"] = "zmq_send_boundary_unavailable"
+    elif case == "failed_request":
+        request["stages"]["add_request"].update(status="error", calls=1, exceptions=1)
+    dashboard = report.build_dashboard(records)
+    node = next(row for row in dashboard["nodes"] if row["node_key"] == "add_request" and row["scope"] == "request")
+    assert node["status"] == request["stages"]["add_request"]["status"]
+    assert node["duration_ns"] is None
+    assert not any(link["kind"] == "add_request_owner" for link in dashboard["transport_links"])
