+def test_n_children_each_go_through_add_request(caplog, monkeypatch):
+    """As in v0.30.0, a replacement of _add_request sees every child of an n>1 request."""
+    from vllm.sampling_params import SamplingParams
+    from vllm.v1.engine import EngineCoreRequest
+    from vllm.v1.engine.async_llm import AsyncLLM
+
+    caplog.set_level(logging.INFO, logger=diag.__name__)
+    original = AsyncLLM._add_request
+    seen, sent = [], []
+
+    async def replacement(self, request, *args, **kwargs):
+        seen.append((request.request_id, sorted(kwargs)))
+        return await original(self, request, *args, **kwargs)
+
+    monkeypatch.setattr(AsyncLLM, "_add_request", replacement)
+
+    async def add_request_async(request):
+        sent.append(request.request_id)
+
+    engine = AsyncLLM.__new__(AsyncLLM)
+    engine.engine_core = SimpleNamespace(
+        add_request_async=add_request_async, resources=SimpleNamespace(engine_dead=False)
+    )
+    engine.output_handler = None
+    engine.vllm_config = SimpleNamespace(cache_config=SimpleNamespace(kv_sharing_fast_prefill=False))
+    engine.check_admission = lambda *args, **kwargs: None
+    engine.input_processor = SimpleNamespace(
+        assign_request_id=lambda r: setattr(r, "external_req_id", r.request_id)
+    )
+    engine._run_output_handler = lambda: None
+    engine.output_processor = SimpleNamespace(
+        has_request=lambda request_id: False, add_request=lambda *args: None
+    )
+    engine.log_requests = False
+    request = EngineCoreRequest(
+        request_id="req-n2",
+        prompt_token_ids=[1, 2, 3],
+        mm_features=None,
+        sampling_params=SamplingParams(n=2, max_tokens=2),
+        pooling_params=None,
+        arrival_time=0,
+        lora_request=None,
+        cache_salt=None,
+        data_parallel_rank=None,
+    )
+    asyncio.run(engine.add_request("req-n2", request, request.sampling_params))
+    assert seen == [("0_req-n2", ["accounted", "owner"]), ("1_req-n2", ["accounted", "owner"])]
+    assert sent == ["0_req-n2", "1_req-n2"]
+    submissions = [r for r in pd_rows(caplog) if r.get("scope") == "engine_submission"]
+    assert len(submissions) == 1
+    sends = [link for link in submissions[0]["links"] if link.get("kind") == "add_request_send"]
+    assert [link["request_id"] for link in sends] == ["0_req-n2", "1_req-n2"]
+
