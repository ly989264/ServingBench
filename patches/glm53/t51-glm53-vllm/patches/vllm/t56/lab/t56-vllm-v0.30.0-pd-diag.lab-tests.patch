+def core_sender(api, send):
+    """Exercise production encoding, ADD dispatch, ZMQ future and await order."""
+    client = api.core.AsyncMPClient()
+    client.client_index = 0
+    client.core_engine = b"engine"
+    client.ensure_alive = lambda: None
+    client.encoder = SimpleNamespace(encode=lambda request: (request,))
+    client.input_socket = SimpleNamespace(
+        send_multipart=lambda message, **kwargs: asyncio.create_task(send(message[-1]))
+    )
+    client._ensure_output_queue_task = lambda: None
+    return client
