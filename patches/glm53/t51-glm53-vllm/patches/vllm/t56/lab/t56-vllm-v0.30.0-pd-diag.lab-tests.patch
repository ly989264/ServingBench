diff --git a/tests/v1/worker/test_pd_finish_claim.py b/tests/v1/worker/test_pd_finish_claim.py
new file mode 100644
index 0000000000000000000000000000000000000000..1f67ee0ba8904cf68e7b1ea031f84778d75f6623
--- /dev/null
+++ b/tests/v1/worker/test_pd_finish_claim.py
@@ -0,0 +1,229 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Runner-held worker_summary records (pd_claim_finish); default path unchanged."""
+
+import json
+import logging
+import subprocess
+import sys
+import textwrap
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.v1.metrics import pd_diagnostics as diag
+from vllm.v1.worker import worker_base as wb
+
+GROUP = SimpleNamespace(rank_in_group=0)
+VOLATILE = {"timestamp_ns", "record_id", "native_tid", "start_ns", "end_ns", "duration_ns"}
+
+
+@pytest.fixture
+def rows(caplog, monkeypatch):
+    caplog.set_level(logging.INFO, logger=diag.__name__)
+    monkeypatch.setattr("vllm.distributed.get_tp_group", lambda: GROUP)
+    monkeypatch.setattr("vllm.distributed.get_pp_group", lambda: GROUP)
+
+    def read():
+        return [
+            json.loads(r.getMessage().split("[PD_DIAG] ", 1)[1])
+            for r in caplog.records
+            if "[PD_DIAG] " in r.getMessage()
+            and '"event":"worker_summary"' in r.getMessage()
+        ]
+
+    return read
+
+
+def sched_output(execution_id="execution-t-1-7", request_ids=("a", "b")):
+    return SimpleNamespace(
+        pd_execution_id=execution_id,
+        num_scheduled_tokens={rid: 1 for rid in request_ids},
+    )
+
+
+class Runner:
+    parallel_config = SimpleNamespace(data_parallel_index=0)
+
+    def __init__(self, claim=0, fail=None, release_inside=False):
+        self.claim = claim
+        self.fail = fail
+        self.release_inside = release_inside
+        self.claims = []
+
+    def _body(self, stage):
+        with diag.span(stage, completion="host_return"):
+            pass
+        for _ in range(self.claim):
+            self.claims.append(wb.pd_claim_finish())
+        if self.release_inside and self.claims:
+            self.claims[0].release()
+        if self.fail is not None:
+            raise self.fail
+        return "native_result"
+
+    @wb.pd_execution
+    def execute_model(self, scheduler_output, intermediate_tensors=None):
+        return self._body("runner.forward")
+
+    @wb.pd_sample
+    def sample_tokens(self, grammar_output):
+        return self._body("runner.sampling")
+
+
+def strip(record):
+    def walk(value):
+        if isinstance(value, dict):
+            return {k: walk(v) for k, v in value.items() if k not in VOLATILE}
+        if isinstance(value, list):
+            return [walk(v) for v in value]
+        return value
+
+    return walk(record)
+
+
+def run_steps(runner, output, fail):
+    for call in (lambda: runner.execute_model(output), lambda: runner.sample_tokens(None)):
+        if fail is None:
+            assert call() == "native_result"
+        else:
+            with pytest.raises(type(fail)):
+                call()
+
+
+@pytest.mark.parametrize("fail", [None, ValueError("boom"), KeyboardInterrupt()])
+def test_default_off_matches_original_wrapper(rows, monkeypatch, fail):
+    output = sched_output()
+    # Patch 01's original decorators differ only in using diag.batch(...) here.
+    with monkeypatch.context() as m:
+        m.setattr(
+            wb,
+            "_pd_worker_batch",
+            lambda phase, context: diag.batch("worker_summary", phase=phase, **context),
+        )
+        run_steps(Runner(fail=fail), output, fail)
+    expected = [strip(r) for r in rows()]
+    before = len(rows())
+    run_steps(Runner(fail=fail), output, fail)
+    got = [strip(r) for r in rows()[before:]]
+    assert len(expected) == 2
+    assert got == expected
+
+
+def test_claim_holds_until_release_then_writes_once(rows):
+    runner = Runner(claim=2)
+    assert runner.execute_model(sched_output()) == "native_result"
+    assert runner.claims[0] is runner.claims[1]
+    assert rows() == []
+    claim = runner.claims[0]
+    assert claim.set_stage_fields("forward", device_duration_ns=1234)
+    assert not claim.set_stage_fields("no_such_stage", x=1)
+    claim.release()
+    claim.release()
+    out = rows()
+    assert len(out) == 1
+    assert out[0]["phase"] == "execute" and out[0]["status"] == "ok"
+    assert out[0]["error_type"] is None
+    assert out[0]["stages"]["forward"]["device_duration_ns"] == 1234
+    assert out[0]["execution_id"] == "execution-t-1-7"
+    assert not claim.set_stage_fields("forward", device_duration_ns=1)
+
+
+def test_release_before_return_writes_at_return(rows):
+    runner = Runner(claim=1, release_inside=True)
+    assert runner.sample_tokens(None) == "native_result"
+    out = rows()
+    assert len(out) == 1 and out[0]["phase"] == "sample"
+    runner.claims[0].release()
+    assert len(rows()) == 1
+
+
+@pytest.mark.parametrize(
+    "fail,status", [(ValueError("boom"), "error"), (KeyboardInterrupt(), "cancelled")]
+)
+def test_error_step_written_at_once(rows, fail, status):
+    runner = Runner(claim=1, fail=fail)
+    with pytest.raises(type(fail)):
+        runner.execute_model(sched_output())
+    out = rows()
+    assert len(out) == 1
+    assert out[0]["status"] == status
+    assert out[0]["error_type"] == type(fail).__name__
+    claim = runner.claims[0]
+    assert not claim.set_stage_fields("forward", device_duration_ns=1)
+    claim.release()
+    assert len(rows()) == 1
+
+
+def test_release_from_another_thread(rows):
+    runner = Runner(claim=1)
+    runner.execute_model(sched_output())
+    thread = threading.Thread(target=runner.claims[0].release)
+    thread.start()
+    thread.join()
+    assert len(rows()) == 1
+
+
+def test_no_open_record_returns_none(rows):
+    assert wb.pd_claim_finish() is None
+
+    class Dummy(Runner):
+        @wb.pd_execution
+        def execute_model(self, scheduler_output, intermediate_tensors=None,
+                          dummy_run=False):
+            return wb.pd_claim_finish()
+
+    assert Dummy().execute_model(sched_output(), None, True) is None
+    assert rows() == []
+
+
+def test_release_claims_writes_held_records(rows):
+    runner = Runner(claim=1)
+    runner.execute_model(sched_output("execution-t-1-8"))
+    runner.claim = 0
+    runner.sample_tokens(None)
+    assert len(rows()) == 1  # sample written at return, execute held
+    wb.pd_release_claims()
+    out = rows()
+    assert len(out) == 2
+    assert {r["phase"] for r in out} == {"execute", "sample"}
+    wb.pd_release_claims()
+    assert len(rows()) == 2
+
+
+def test_held_record_written_at_interpreter_exit():
+    script = textwrap.dedent(
+        """
+        import sys
+        from types import SimpleNamespace
+        import vllm.distributed as vd
+        from vllm.v1.worker import worker_base as wb
+        g = SimpleNamespace(rank_in_group=0)
+        vd.get_tp_group = lambda: g
+        vd.get_pp_group = lambda: g
+
+        class R:
+            parallel_config = SimpleNamespace(data_parallel_index=0)
+
+            @wb.pd_execution
+            def execute_model(self, so, intermediate_tensors=None):
+                self.claim = wb.pd_claim_finish()
+                return 1
+
+        so = SimpleNamespace(pd_execution_id="execution-t-9-1",
+                             num_scheduled_tokens={"a": 1})
+        R().execute_model(so)
+        print("RETURNED", flush=True)
+        """
+    )
+    proc = subprocess.run(
+        [sys.executable, "-c", script], capture_output=True, text=True, timeout=300
+    )
+    assert proc.returncode == 0, proc.stderr[-2000:]
+    out = proc.stdout + proc.stderr
+    lines = [line for line in out.splitlines() if '"event":"worker_summary"' in line]
+    assert len(lines) == 1
+    assert out.index("RETURNED") < out.index('"event":"worker_summary"')
+    record = json.loads(lines[0].split("[PD_DIAG] ", 1)[1])
+    assert record["status"] == "ok" and record["execution_id"] == "execution-t-9-1"
