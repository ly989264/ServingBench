+def test_startup_worker_timing_line_runner_stages(caplog, monkeypatch):
+    """vllm-ascend's DeviceTiming lists the stages it times. Three cases: D by default (six stages,
+    source=default), D with VLLM_PD_DEVICE_STAGES=none (forward,sampling, source=env), not D (empty:
+    no suffix, the T51 line character for character; also when the attributes are absent)."""
+    t51 = ["PD_DIAG_STARTUP worker device_timing=on tp_rank=0"]
+    all_on = ("forward", "sampling", "prepare_inputs", "lm_head", "draft", "bookkeeping")
+    assert _timing_line(caplog, monkeypatch, SimpleNamespace(
+        enabled=True, runner_stages=all_on, stages_source="default")) == [
+        "PD_DIAG_STARTUP worker device_timing=on tp_rank=0 runner_stages=forward,sampling,"
+        "prepare_inputs,lm_head,draft,bookkeeping source=default"]
+    assert _timing_line(caplog, monkeypatch, SimpleNamespace(
+        enabled=True, runner_stages=("forward", "sampling"), stages_source="env")) == [
+        "PD_DIAG_STARTUP worker device_timing=on tp_rank=0 runner_stages=forward,sampling source=env"]
+    assert _timing_line(caplog, monkeypatch, SimpleNamespace(
+        enabled=True, runner_stages=(), stages_source="default")) == t51
+    assert _timing_line(caplog, monkeypatch, SimpleNamespace(enabled=True)) == t51  # T51 vllm-ascend
+    # A subset from the environment, and a source that is neither value.
+    assert _timing_line(caplog, monkeypatch, SimpleNamespace(
+        enabled=True, runner_stages=("forward", "sampling", "lm_head", "draft"), stages_source="env")) == [
+        "PD_DIAG_STARTUP worker device_timing=on tp_rank=0 runner_stages=forward,sampling,lm_head,draft "
+        "source=env"]
+    assert _timing_line(caplog, monkeypatch, SimpleNamespace(
+        enabled=False, runner_stages=["forward", "sampling"], stages_source=None)) == [
+        "PD_DIAG_STARTUP worker device_timing=off tp_rank=0 runner_stages=forward,sampling source=?"]
+
