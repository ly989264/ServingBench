+
+def test_add_request_without_owner_sends_and_writes_nothing(caplog):
+    """The old call shape _add_request(request, prompt, parent, index, queue)."""
+    from vllm.v1.engine.async_llm import AsyncLLM
+
+    caplog.set_level(logging.INFO, logger=diag.__name__)
+    sent = []
+
+    async def add_request_async(request):
+        sent.append(request)
+
+    engine = AsyncLLM.__new__(AsyncLLM)
+    engine.engine_core = SimpleNamespace(add_request_async=add_request_async)
+    engine.output_processor = SimpleNamespace(
+        has_request=lambda request_id: True, add_request=lambda *args: None
+    )
+    engine.log_requests = False
+    request = SimpleNamespace(request_id="req-0", pd_tokenization=None)
+    asyncio.run(engine._add_request(request, None, None, 0, None))
+    assert sent == [request]
+    assert pd_rows(caplog) == []
