+def test_actual_submission_failure_supersedes_only_legacy_copy(
+    synthetic, status, timing_scope
+):
+    _, original, _ = synthetic
+    records = json.loads(json.dumps(original))
+    for record in records:
+        if record["event"] != "api_summary" or record.get("observation_id") not in (
+            "http-P", "http-D"
+        ):
