+
+    caplog.set_level(logging.INFO, logger=wb.__name__)
+    monkeypatch.setattr(wb, "_PD_STARTUP_RUNNER_LOGGED", False)
+    monkeypatch.setattr(wb, "_PD_STARTUP_TIMING_LOGGED", False)
+
+    def not_initialized():
+        raise AssertionError("tensor model parallel group is not initialized")
+
+    monkeypatch.setattr(vllm.distributed, "get_tp_group", not_initialized)
+
+    class Broken:
+        def __getattr__(self, name):
+            raise RuntimeError(name)
+
+    wb._pd_startup_log_runner(Broken())  # swallowed, and counts as this process's line
+    monkeypatch.setattr(wb, "_PD_STARTUP_RUNNER_LOGGED", False)
+    wb._pd_startup_log_runner(SimpleNamespace(model_runner=object()))
+    wb._pd_startup_log_timing(Broken(), None, Broken())  # swallowed, line not taken
+    wb._pd_startup_log_timing(SimpleNamespace(model_runner=object()), {"tp_rank": "x"},
+                              SimpleNamespace(total_num_scheduled_tokens=3))
+    assert startup_lines(caplog) == [
