+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""core_summary[request].stages.kv_ready_wait on the real scheduler, the D test
+is_pd_decode(), and the four runner span names.
+
+D here is what it is on site: top-level kv_role kv_consumer, and vllm-ascend's
+condition is_pd_decode_recompute_scheduler_enabled() true. vllm_ascend is not
+installed in this environment; a stand-in vllm_ascend.utils carries the same
+condition (utils.py of vllm-ascend d4ad49796) with the recompute switch on."""
+
+import json
+import logging
+import sys
+import time
+import types
+from types import SimpleNamespace
+
+import pytest
+
+from tests.v1.core.utils import create_requests, create_scheduler, mock_kv
+from tests.v1.kv_connector.unit.utils import create_model_runner_output
+from vllm.v1.metrics import pd_diagnostics as diag
+from vllm.v1.outputs import KVConnectorOutput, ModelRunnerOutput
+from vllm.v1.request import RequestStatus
+from vllm.v1.structured_output import StructuredOutputManager
+
+BLOCK = 16
+PROMPT = 2 * BLOCK
+STAGE_KEYS = {
+    "calls", "duration_ns", "start_ns", "end_ns", "status", "exceptions", "measured_calls",
+    "skipped_calls", "unmeasured_calls", "ranges", "dropped_ranges", "complete", "end_observed",
+    "timing_scope",
+}
+RANGE_KEYS = [
+    "episode", "start_ns", "promoted_ns", "end_ns", "duration_ns", "ready_execution_id",
+    "scheduled_execution_id", "status", "load_failed",
+]
+
+
+def ascend_utils(monkeypatch, check):
+    module = types.ModuleType("vllm_ascend.utils")
+    module.is_pd_decode_recompute_scheduler_enabled = check
+    monkeypatch.setitem(sys.modules, "vllm_ascend.utils", module)
+
+
+def ascend_condition(recompute):
+    """vllm-ascend's own condition (utils.py of d4ad49796): top-level consumer, not producer,
+    and recompute on."""
+    def check(vllm_config):
+        kv = vllm_config.kv_transfer_config
+        if kv is None or not kv.is_kv_consumer or kv.is_kv_producer:
+            return False
+        return recompute
+    return check
+
+
+@pytest.fixture(autouse=True)
+def recompute_on(monkeypatch):
+    ascend_utils(monkeypatch, ascend_condition(recompute=True))
+
+
+def build(*, role="kv_consumer", matched=PROMPT, is_async=True, policy="fail", async_scheduling=False,
+          prefix_caching=True, **kwargs):
+    """D by default (kv_consumer with recompute on); policy is set before the scheduler is built."""
+    base = create_scheduler(
+        enable_prefix_caching=prefix_caching,
+        use_kv_connector=mock_kv(matched_tokens=matched, is_async=is_async),
+        kv_role=role,
+        block_size=BLOCK,
+        async_scheduling=async_scheduling,
+        **kwargs,
+    )
+    config = base.vllm_config
+    config.kv_transfer_config.kv_load_failure_policy = policy
+    scheduler = type(base)(
+        vllm_config=config,
+        kv_cache_config=base.kv_cache_config,
+        block_size=BLOCK,
+        log_stats=True,
+        structured_output_manager=StructuredOutputManager(config),
+    )
+    scheduler.use_v2_model_runner = base.use_v2_model_runner
+    return scheduler
+
+
+def rows(caplog):
+    return [
+        json.loads(r.getMessage().split("[PD_DIAG] ", 1)[1])
+        for r in caplog.records
+        if "[PD_DIAG] " in r.getMessage()
+    ]
+
+
+def request_record(caplog, request_id):
+    found = [
+        r for r in rows(caplog)
+        if r["event"] == "core_summary" and r.get("scope") == "request"
+        and r.get("request_id") == request_id
+    ]
+    assert len(found) == 1
+    return found[0]
+
+
+def schedule_start(caplog, execution_id):
+    found = [
+        r for r in rows(caplog)
+        if r["event"] == "core_summary" and r.get("scope") == "execution"
+        and r.get("execution_id") == execution_id
+    ]
+    assert len(found) == 1
+    return found[0]["stages"]["schedule"]["start_ns"]
+
+
+def update(scheduler, output, model_output):
+    """As EngineCore does: update_from_output inside the scope of the step it completes."""
+    with diag.scope(execution_id=output.pd_execution_id):
+        return scheduler.update_from_output(output, model_output)
+
+
+def empty():
+    return ModelRunnerOutput(req_ids=[], req_id_to_index={}, sampled_token_ids=[],
+                             logprobs=None, prompt_logprobs_dict={}, pooler_output=[])
+
+
+def kv_output(reqs=(), **fields):
+    out = create_model_runner_output(list(reqs))
+    out.kv_connector_output = KVConnectorOutput(**fields)
+    return out
+
+
+def one(request_id="r", max_tokens=1, num_tokens=PROMPT):
+    return create_requests(num_requests=1, num_tokens=num_tokens, max_tokens=max_tokens,
+                           block_size=BLOCK, req_ids=[request_id])[0]
+
+
+@pytest.fixture
+def records(caplog):
+    caplog.set_level(logging.INFO, logger=diag.__name__)
+    return caplog
+
+
+def to_ready(scheduler, request):
+    """Step the request into WAITING_FOR_REMOTE_KVS and report its KV ready; returns
+    the output of the step whose result reported it."""
+    scheduler.add_request(request)
+    first = scheduler.schedule()
+    assert request.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    update(scheduler, first, empty())
+    second = scheduler.schedule()
+    update(scheduler, second, kv_output(finished_recving={request.request_id}))
+    return second
+
+
+def finish(scheduler, output, request):
+    update(scheduler, output, create_model_runner_output([request], token_id=7))
+    assert request.is_finished()
+
+
+# --- normal path -----------------------------------------------------------------------------
+
+
+def test_round_ends_at_the_start_of_the_schedule_call_that_runs_it(records):
+    scheduler = build()
+    request = one()
+    ready = to_ready(scheduler, request)
+    run = scheduler.schedule()
+    assert request.request_id in run.num_scheduled_tokens
+    finish(scheduler, run, request)
+
+    record = request_record(records, "r")
+    stage = record["stages"]["kv_ready_wait"]
+    assert set(stage) == STAGE_KEYS
+    (first,) = stage["ranges"]
+    assert list(first) == RANGE_KEYS
+    # The equality to check on site: end_ns is the same step's stages.schedule.start_ns.
+    assert stage["end_ns"] == schedule_start(records, run.pd_execution_id)
+    assert first["end_ns"] == stage["end_ns"] and first["start_ns"] == stage["start_ns"]
+    assert stage["duration_ns"] == stage["end_ns"] - stage["start_ns"] >= 0
+    assert first["ready_execution_id"] == ready.pd_execution_id
+    assert first["scheduled_execution_id"] == run.pd_execution_id
+    # Promoted inside the same schedule() call, after its start.
+    assert first["promoted_ns"] >= first["end_ns"]
+    assert stage | {"ranges": None} == {
+        "calls": 1, "duration_ns": stage["duration_ns"], "start_ns": stage["start_ns"],
+        "end_ns": stage["end_ns"], "status": "ok", "exceptions": 0, "measured_calls": 1,
+        "skipped_calls": 0, "unmeasured_calls": 0, "ranges": None, "dropped_ranges": 0,
+        "complete": True, "end_observed": True, "timing_scope": "kv_ready_seen_to_scheduled",
+    }
+    assert first["episode"] == 1 and first["status"] == "ok" and first["load_failed"] is False
+    assert list(record["stages"]) == ["queue", "hash", "kv_ready_wait"]
+
+
+def test_async_scheduling_ends_at_the_first_schedule_after_ready_was_seen(records):
+    """Batch queue order: the next schedule() starts before the older step's result is
+    processed; the round ends at the schedule() after the one that saw it ready."""
+    scheduler = build(async_scheduling=True)
+    request = one()
+    scheduler.add_request(request)
+    a = scheduler.schedule()
+    assert request.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    b = scheduler.schedule()  # submitted before a's result
+    update(scheduler, a, kv_output(finished_recving={"r"}))
+    assert request.request_id not in b.num_scheduled_tokens
+    update(scheduler, b, empty())
+    c = scheduler.schedule()
+    assert request.request_id in c.num_scheduled_tokens
+    finish(scheduler, c, request)
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    (first,) = stage["ranges"]
+    assert first["ready_execution_id"] == a.pd_execution_id
+    assert first["scheduled_execution_id"] == c.pd_execution_id
+    assert stage["end_ns"] == schedule_start(records, c.pd_execution_id)
+    assert stage["status"] == "ok" and stage["calls"] == 1
+
+
+def test_promoted_but_not_admitted_waits_more_steps(records):
+    """Promoted in a throttled step that defers local prefill, run in the next one."""
+    scheduler = build(matched=PROMPT // 2)
+    running = one("run", max_tokens=8, num_tokens=PROMPT)
+    other = one("r", num_tokens=2 * PROMPT)
+    to_ready(scheduler, running)
+    out = scheduler.schedule()
+    assert "run" in out.num_scheduled_tokens
+    update(scheduler, out, create_model_runner_output([running], token_id=1))
+    scheduler.add_request(other)
+    seen = scheduler.schedule()
+    assert other.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    update(scheduler, seen, create_model_runner_output([running], token_id=1, finished_recving={"r"}))
+    throttled = scheduler.schedule(throttle_prefills=True)
+    assert "r" not in throttled.num_scheduled_tokens and other.status == RequestStatus.WAITING
+    update(scheduler, throttled, create_model_runner_output([running], token_id=1))
+    run = scheduler.schedule()
+    assert "r" in run.num_scheduled_tokens
+    scheduler.finish_requests(["r", "run"], RequestStatus.FINISHED_ABORTED)
+    first = request_record(records, "r")["stages"]["kv_ready_wait"]["ranges"][0]
+    assert first["start_ns"] < first["promoted_ns"]
+    assert schedule_start(records, throttled.pd_execution_id) < first["promoted_ns"]
+    assert first["promoted_ns"] < first["end_ns"] == schedule_start(records, run.pd_execution_id)
+    assert first["ready_execution_id"] == seen.pd_execution_id
+    assert first["scheduled_execution_id"] == run.pd_execution_id
+    assert first["status"] == "ok"
+
+
+def test_preempted_and_loaded_again_counts_a_second_round(records):
+    scheduler = build(prefix_caching=False)
+    request = one(max_tokens=4)
+    to_ready(scheduler, request)
+    run = scheduler.schedule()
+    update(scheduler, run, create_model_runner_output([request], token_id=1))
+    scheduler.running.remove(request)
+    scheduler._preempt_request(request, time.monotonic())
+    out = scheduler.schedule()  # the connector loads it asynchronously again
+    assert request.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    update(scheduler, out, kv_output(finished_recving={"r"}))
+    again = scheduler.schedule()
+    assert "r" in again.num_scheduled_tokens
+    scheduler.finish_requests("r", RequestStatus.FINISHED_ABORTED)
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    first, second = stage["ranges"]
+    assert stage["calls"] == 2 and stage["status"] == "ok"
+    assert stage["duration_ns"] == first["duration_ns"]  # the first round counts
+    assert stage["end_ns"] == first["end_ns"] == schedule_start(records, run.pd_execution_id)
+    assert second["episode"] == 2 and second["status"] == "ok"
+    assert second["end_ns"] == schedule_start(records, again.pd_execution_id)
+
+
+def test_ready_reported_twice_before_promotion_keeps_one_round(records):
+    scheduler = build()
+    request = one()
+    scheduler.add_request(request)
+    out = scheduler.schedule()
+    update(scheduler, out, kv_output(finished_recving={"r"}))
+    first_start = request.pd_kv_ready["open"]["start_ns"]
+    scheduler._update_from_kv_xfer_finished(KVConnectorOutput(finished_recving={"r"}))
+    assert request.pd_kv_ready["episode"] == 1
+    assert request.pd_kv_ready["open"]["start_ns"] == first_start
+
+
+# --- failures, aborts, shutdown ----------------------------------------------------------------
+
+
+def test_load_failure_with_policy_fail_has_no_start(records):
+    scheduler = build(policy="fail")
+    request = one()
+    scheduler.add_request(request)
+    out = scheduler.schedule()
+    update(scheduler, out, kv_output(failed_recving={"r"}, finished_recving={"r"}))
+    assert request.status == RequestStatus.FINISHED_ERROR
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    (first,) = stage["ranges"]
+    assert first["start_ns"] is None and first["end_ns"] is None
+    assert first["status"] == "error" and first["load_failed"] is True
+    assert stage["status"] == "error" and stage["calls"] == 1
+    assert stage["duration_ns"] is None and stage["start_ns"] is None
+    assert stage["complete"] is False and stage["end_observed"] is False
+    assert stage["exceptions"] == 1
+
+
+def test_invalid_blocks_with_policy_fail_count_as_load_failure(records):
+    scheduler = build(policy="fail")
+    request = one()
+    scheduler.add_request(request)
+    out = scheduler.schedule()
+    block_id = scheduler.kv_cache_manager.get_block_ids("r")[0][0]
+    update(scheduler, out, kv_output(invalid_block_ids={block_id}, finished_recving={"r"}))
+    assert request.status == RequestStatus.FINISHED_ERROR
+    (first,) = request_record(records, "r")["stages"]["kv_ready_wait"]["ranges"]
+    assert first["status"] == "error" and first["load_failed"] is True and first["start_ns"] is None
+
+
+def test_load_failure_with_policy_recompute_runs_and_marks_the_round(records):
+    """The connector has nothing more to load: the whole prompt is computed locally."""
+    scheduler = build(policy="recompute")
+    request = one()
+    scheduler.add_request(request)
+    out = scheduler.schedule()
+    update(scheduler, out, kv_output(failed_recving={"r"}, finished_recving={"r"}))
+    scheduler.connector.get_num_new_matched_tokens = lambda req, computed: (0, False)
+    run = scheduler.schedule()
+    assert "r" in run.num_scheduled_tokens
+    assert run.num_scheduled_tokens["r"] == PROMPT  # the whole prompt again, locally
+    finish(scheduler, run, request)
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    (first,) = stage["ranges"]
+    assert stage["status"] == "ok" and first["load_failed"] is True
+    assert stage["end_ns"] == schedule_start(records, run.pd_execution_id)
+
+
+def test_load_failure_with_policy_recompute_and_a_new_async_load(records):
+    """The connector starts another async load after the failed one: the failed round is
+    closed as missing when the next KV ready opens round 2 (it never reached running)."""
+    scheduler = build(policy="recompute")
+    request = one()
+    scheduler.add_request(request)
+    out = scheduler.schedule()
+    update(scheduler, out, kv_output(failed_recving={"r"}, finished_recving={"r"}))
+    again = scheduler.schedule()  # promoted, then loading again
+    assert request.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    update(scheduler, again, kv_output(finished_recving={"r"}))
+    run = scheduler.schedule()
+    assert "r" in run.num_scheduled_tokens
+    finish(scheduler, run, request)
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    first, second = stage["ranges"]
+    assert first["status"] == "missing" and first["load_failed"] is True
+    assert first["promoted_ns"] is not None and first["end_ns"] is None
+    assert second["status"] == "ok" and second["load_failed"] is False
+    assert second["end_ns"] == schedule_start(records, run.pd_execution_id)
+    assert stage["status"] == "missing" and stage["calls"] == 2
+
+
+@pytest.mark.parametrize("when", ["before_ready", "after_ready", "after_promotion"])
+def test_abort_while_waiting_is_cancelled(records, when):
+    scheduler = build(matched=PROMPT // 2)
+    blocker = one("run", max_tokens=8)
+    request = one("r", num_tokens=2 * PROMPT)
+    if when == "after_promotion":
+        to_ready(scheduler, blocker)
+        out = scheduler.schedule()
+        update(scheduler, out, create_model_runner_output([blocker], token_id=1))
+    scheduler.add_request(request)
+    out = scheduler.schedule()
+    assert request.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    if when != "before_ready":
+        update(scheduler, out, create_model_runner_output(
+            [blocker] if when == "after_promotion" else [], token_id=1, finished_recving={"r"}))
+    if when == "after_promotion":
+        out = scheduler.schedule(throttle_prefills=True)
+        assert request.status == RequestStatus.WAITING
+    scheduler.finish_requests("r", RequestStatus.FINISHED_ABORTED)
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    (first,) = stage["ranges"]
+    assert stage["status"] == first["status"] == "cancelled"
+    assert first["end_ns"] is None and stage["end_observed"] is False
+    assert (first["start_ns"] is None) == (when == "before_ready")
+    assert (first["promoted_ns"] is not None) == (when == "after_promotion")
+
+
+def test_shutdown_while_waiting_is_cancelled(records):
+    scheduler = build()
+    request = one()
+    scheduler.add_request(request)
+    out = scheduler.schedule()
+    update(scheduler, out, kv_output(finished_recving={"r"}))
+    scheduler.shutdown()
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    assert stage["status"] == "cancelled" and stage["start_ns"] is not None
+    assert stage["end_ns"] is None
+
+
+def test_shutdown_before_ready_is_cancelled_without_start(records):
+    scheduler = build()
+    request = one()
+    scheduler.add_request(request)
+    scheduler.schedule()
+    assert request.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+    scheduler.shutdown()
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    (first,) = stage["ranges"]
+    assert stage["status"] == first["status"] == "cancelled"
+    assert first["start_ns"] is None and first["end_ns"] is None
+
+
+def test_shutdown_of_a_running_request_keeps_its_round(records):
+    scheduler = build()
+    request = one(max_tokens=4)
+    to_ready(scheduler, request)
+    run = scheduler.schedule()
+    scheduler.shutdown()
+    stage = request_record(records, "r")["stages"]["kv_ready_wait"]
+    assert stage["status"] == "ok" and stage["calls"] == 1
+    assert stage["end_ns"] == schedule_start(records, run.pd_execution_id)
+
+
+# --- only D, only requests that had a round ----------------------------------------------------
+
+
+@pytest.mark.parametrize("async_scheduling", [False, True])
+@pytest.mark.parametrize("case", ["producer_with_recompute", "producer", "consumer_recompute_off",
+                                  "both_with_recompute", "no_vllm_ascend"])
+def test_not_d_writes_nothing_even_with_async_loads(records, monkeypatch, case, async_scheduling):
+    """Not D, here even with an async-loading connector: nothing new in the records.
+    producer_with_recompute is a P configured with the recompute switch."""
+    role = {"producer_with_recompute": "kv_producer", "producer": "kv_producer",
+            "both_with_recompute": "kv_both"}.get(case, "kv_consumer")
+    if case in ("producer", "consumer_recompute_off"):
+        ascend_utils(monkeypatch, ascend_condition(recompute=False))
+    if case == "no_vllm_ascend":
+        monkeypatch.delitem(sys.modules, "vllm_ascend.utils")
+    scheduler = build(role=role, async_scheduling=async_scheduling)
+    assert scheduler._pd_decode is False
+    request = one()
+    to_ready(scheduler, request)
+    run = scheduler.schedule()
+    finish(scheduler, run, request)
+    record = request_record(records, "r")
+    assert list(record["stages"]) == ["queue", "hash"]
+    assert request.pd_kv_ready is None
+    assert scheduler._pd_kv_ready_open == []
+
+
+@pytest.mark.parametrize("matched,is_async", [(0, False), (BLOCK, False)])
+def test_d_without_async_load_writes_no_stage(records, matched, is_async):
+    """D, but nothing to load remotely, or a synchronous load."""
+    scheduler = build(matched=matched, is_async=is_async)
+    assert scheduler._pd_decode is True
+    request = one()
+    scheduler.add_request(request)
+    run = scheduler.schedule()
+    finish(scheduler, run, request)
+    assert "kv_ready_wait" not in request_record(records, "r")["stages"]
+    assert request.pd_kv_ready is None
+
+
+# --- the round state on the request ------------------------------------------------------------
+
+
+def test_rounds_are_bounded_and_a_negative_duration_is_invalid(records, monkeypatch):
+    clock = iter(range(1000, 10 ** 6, 10))
+    monkeypatch.setattr(time, "monotonic_ns", lambda: next(clock))
+    request = one("x")
+    for _ in range(66):
+        request.pd_kv_ready_transition("ready")
+        start = request.pd_kv_ready["open"]["start_ns"]
+        request.pd_kv_ready_transition("scheduled", now_ns=start + 5, execution_id="e")
+    request.pd_kv_ready_transition("ready")
+    request.pd_kv_ready_transition("scheduled", now_ns=0, execution_id="e")  # clock went back
+    request.status = RequestStatus.FINISHED_ABORTED
+    request.pd_queue_transition("finished")
+    stage = request_record(records, "x")["stages"]["kv_ready_wait"]
+    assert stage["calls"] == 67 and len(stage["ranges"]) == 64 and stage["dropped_ranges"] == 3
+    assert stage["duration_ns"] == 5 and stage["status"] == "ok"
+    request2 = one("y")
+    request2.pd_kv_ready_transition("ready")
+    request2.pd_kv_ready_transition("scheduled", now_ns=0, execution_id="e")
+    request2.status = RequestStatus.FINISHED_ABORTED
+    request2.pd_queue_transition("finished")
+    stage = request_record(records, "y")["stages"]["kv_ready_wait"]
+    assert stage["status"] == "invalid" and stage["duration_ns"] is None
+    assert stage["ranges"][0]["duration_ns"] is None and stage["complete"] is True
+
+
+def test_a_new_ready_closes_the_open_round_as_missing(records):
+    request = one("x")
+    request.pd_kv_ready_transition("ready")
+    request.pd_kv_ready_transition("ready")
+    request.status = RequestStatus.FINISHED_STOPPED
+    request.pd_queue_transition("finished")
+    stage = request_record(records, "x")["stages"]["kv_ready_wait"]
+    assert [r["status"] for r in stage["ranges"]] == ["missing", "missing"]
+    assert stage["status"] == "missing" and stage["calls"] == 2
+
+
+# --- is_pd_decode ------------------------------------------------------------------------------
+
+
+def config(kv_role=None):
+    from vllm.config import KVTransferConfig
+
+    kv = KVTransferConfig(kv_connector="ExampleConnector", kv_role=kv_role) if kv_role else None
+    return SimpleNamespace(kv_transfer_config=kv)
+
+
+def test_is_pd_decode_is_vllm_ascend_condition(monkeypatch):
+    assert diag.is_pd_decode(config("kv_consumer")) is True
+    assert diag.is_pd_decode(config("kv_producer")) is False  # recompute configured on a P
+    assert diag.is_pd_decode(config("kv_both")) is False
+    assert diag.is_pd_decode(config()) is False
+    ascend_utils(monkeypatch, ascend_condition(recompute=False))
+    assert diag.is_pd_decode(config("kv_consumer")) is False
+
+
+def test_is_pd_decode_passes_the_config_through(monkeypatch):
+    seen = []
+    ascend_utils(monkeypatch, lambda c: seen.append(c) or 1)
+    value = config("kv_consumer")
+    assert diag.is_pd_decode(value) is True
+    assert seen == [value]
+
+
+def test_is_pd_decode_without_vllm_ascend_is_false_and_imports_nothing(monkeypatch):
+    for name in [n for n in sys.modules if n == "vllm_ascend" or n.startswith("vllm_ascend.")]:
+        monkeypatch.delitem(sys.modules, name)
+    assert diag.is_pd_decode(config("kv_consumer")) is False
+    assert diag.is_pd_decode(None) is False
+    assert not [n for n in sys.modules if n == "vllm_ascend" or n.startswith("vllm_ascend.")]
+    monkeypatch.setitem(sys.modules, "vllm_ascend.utils", types.ModuleType("vllm_ascend.utils"))
+    assert diag.is_pd_decode(config("kv_consumer")) is False  # loaded, without the function
+
+
+def test_is_pd_decode_never_raises(monkeypatch):
+    ascend_utils(monkeypatch, lambda c: (_ for _ in ()).throw(ValueError("broken config")))
+    assert diag.is_pd_decode(config("kv_consumer")) is False
+
+    class Broken:
+        def __bool__(self):
+            raise RuntimeError("no truth value")
+
+    ascend_utils(monkeypatch, lambda c: Broken())
+    assert diag.is_pd_decode(config("kv_consumer")) is False
+
+
+def test_scheduler_decides_once_at_init(monkeypatch):
+    calls = []
+    monkeypatch.setattr(diag, "is_pd_decode", lambda c: calls.append(c) or True)
+    scheduler = build()
+    assert calls[-1] is scheduler.vllm_config and scheduler._pd_decode is True
+    count = len(calls)
+    request = one()
+    to_ready(scheduler, request)
+    scheduler.schedule()
+    scheduler.finish_requests("r", RequestStatus.FINISHED_ABORTED)
+    scheduler.shutdown()
+    assert len(calls) == count
+
+
+# --- the four runner span names -----------------------------------------------------------------
+
+
+@pytest.mark.parametrize("event,stage", [
+    ("runner.prepare_inputs", "prepare_inputs"), ("runner.lm_head", "lm_head"),
+    ("runner.draft", "draft"), ("runner.bookkeeping", "bookkeeping"),
+])
+def test_runner_span_names_record_their_stage(event, stage):
+    summary = diag.Batch("worker_summary", phase="execute")
+    with diag.collect(summary):
+        with diag.span(event):
+            pass
+        with diag.span("runner.not_a_stage"):
+            pass
+    assert list(summary.stages) == [stage]
+    value = summary.stages[stage]
+    assert value["calls"] == 1 and value["status"] == "ok" and value["duration_ns"] >= 0
+
+
+def test_runner_spans_outside_a_batch_record_nothing():
+    with diag.span("runner.lm_head") as values:
+        pass
+    assert values["status"] == "ok"
