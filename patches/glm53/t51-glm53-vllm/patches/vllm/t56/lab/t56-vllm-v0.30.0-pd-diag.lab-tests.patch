+def test_add_request_owner_is_optional():
+    from vllm.v1.engine.async_llm import AsyncLLM
+
+    owner = inspect.signature(AsyncLLM._add_request).parameters["owner"]
+    assert owner.kind is inspect.Parameter.KEYWORD_ONLY
+    assert owner.default is None
