+                prefix + "_extra_results": max(0, len(values) - self.key_count),
+            }
+        )
+        if self.byte_sizes is not None:
+            add(**{prefix + "_succeeded_bytes": succeeded_bytes, prefix + "_failed_bytes": failed_bytes})
+        self.recorded = True
+        self.result_status = (
