#!/usr/bin/env python3
"""Lab stand-in for `vllm serve`: builds the same process tree, does nothing else."""
import ctypes
import mmap
import os
import subprocess
import sys
import time


def set_comm(name):
    try:
        ctypes.CDLL(None).prctl(15, name.encode()[:15], 0, 0, 0)
    except Exception:
        pass


def sleep_forever():
    while True:
        time.sleep(3600)


if len(sys.argv) > 2 and sys.argv[1] == "--t51-child":
    kind = sys.argv[2]
    if kind == "engine":
        set_comm("VLLM::EngineCore_DP0")
        tp = int(sys.argv[3])
        kids = [subprocess.Popen([sys.executable, __file__, "--t51-child", "worker", str(i)]) for i in range(tp)]
    else:
        set_comm("VLLM::Worker_TP" + sys.argv[3])
        keep = []
        for path in os.environ.get("T51_FAKE_MAP", "").split(":"):
            if path and os.path.isfile(path) and os.path.getsize(path) > 0:
                f = open(path, "rb")
                keep.append((f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)))
    sleep_forever()

args = sys.argv[1:]
tp = int(args[args.index("--tensor-parallel-size") + 1]) if "--tensor-parallel-size" in args else 1
print("INFO vLLM API server version 0.32.0+empty", flush=True)
print("(EngineCore_DP0 pid=7) INFO [mrv2_utils.py:142] VLLM_USE_V2_MODEL_RUNNER is unset; using Model Runner V2 by default.", flush=True)
if os.environ.get("T51_FAKE_PD_DIAG"):
    print('(Worker_TP0 pid=9) INFO [PD_DIAG] {"event":"worker_summary","runner":"vllm_ascend.worker.v2.model_runner.NPUModelRunner","phase":"execute"}', flush=True)
    print('(APIServer pid=5) INFO [PD_DIAG] {"event":"api_summary","scope":"http"}', flush=True)
engine = subprocess.Popen([sys.executable, __file__, "--t51-child", "engine", str(tp)])
sleep_forever()
