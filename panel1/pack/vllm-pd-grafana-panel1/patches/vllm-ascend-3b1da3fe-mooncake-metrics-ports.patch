+++ b/vllm_ascend/distributed/kv_transfer/utils/mooncake_transfer_engine.py
@@ -1,5 +1,76 @@
+import os
 import threading
 
+# Opt-in, per-process metrics ports for Mooncake (Transfer Engine and store client).
+# Every process on a node needs its own port: port = <base> + <slot>, where <slot> is
+# the worker's global rank (get_global_rank), or SCHEDULER_SLOT_OFFSET + the
+# data-parallel index for scheduler-side store clients, whose process has no world group.
+# A TransferEngine reads MC_TE_METRIC_HTTP_PORT when it is created, so the port is set just
+# before each one: the global TE (connectors) uses TE_METRIC_PORT_BASE_ENV, and a TE that the
+# store creates for itself uses STORE_TE_METRIC_PORT_BASE_ENV. Unset base -> nothing changes.
+TE_METRIC_PORT_BASE_ENV = "VLLM_ASCEND_MC_TE_METRIC_HTTP_PORT_BASE"
+STORE_TE_METRIC_PORT_BASE_ENV = "VLLM_ASCEND_MC_STORE_TE_METRIC_HTTP_PORT_BASE"
+CLIENT_METRIC_PORT_BASE_ENV = "VLLM_ASCEND_MOONCAKE_CLIENT_HTTP_PORT_BASE"
+SCHEDULER_SLOT_OFFSET = 1000
+# parallel config registered by callers that know it, used when the global TE is created
+_global_te_parallel_config = None
+
+
+def metrics_slot(parallel_config=None) -> int | None:
+    from vllm_ascend.distributed.parallel_state import get_global_rank
+
+    if parallel_config is None:
+        try:
+            from vllm.config import get_current_vllm_config
+
+            parallel_config = get_current_vllm_config().parallel_config
+        except Exception:
+            return None
+    try:
+        return get_global_rank(parallel_config)
+    except Exception:
+        # No world group in this process (scheduler-side client): use the DP index.
+        dp_index = getattr(parallel_config, "data_parallel_index", None)
+        if dp_index is None:
+            dp_index = getattr(parallel_config, "data_parallel_rank", 0)
+        return SCHEDULER_SLOT_OFFSET + int(dp_index)
+
+
+def metrics_port(base_env: str, parallel_config=None) -> int | None:
+    base = os.getenv(base_env, "").strip()
+    if not base:
+        return None
+    slot = metrics_slot(parallel_config)
+    if slot is None:
+        from vllm.logger import logger
+
+        logger.warning("%s is set but this process's rank is unknown; metrics port not opened", base_env)
+        return None
+    try:
+        port = int(base) + slot
+    except ValueError:
+        port = None
+    if port is None or not 0 < port <= 65535:
+        # An out-of-range client_http_port makes the store setup fail, so skip the port instead.
+        from vllm.logger import logger
+
+        logger.warning("%s=%r gives no valid metrics port for slot %s; metrics port not opened", base_env, base, slot)
+        return None
+    return port
+
+
+def set_te_metrics_port(parallel_config=None, base_env: str = TE_METRIC_PORT_BASE_ENV) -> None:
+    """Point MC_TE_METRIC_HTTP_PORT at this process's own port before a TransferEngine is created."""
+    port = metrics_port(base_env, parallel_config)
+    if port is not None:
+        os.environ["MC_TE_METRIC_HTTP_PORT"] = str(port)
+
+
+def use_parallel_config_for_te_metrics(parallel_config) -> None:
+    """Register the worker's parallel config so the global TE's metrics port uses it."""
+    global _global_te_parallel_config
+    _global_te_parallel_config = parallel_config
+
 
