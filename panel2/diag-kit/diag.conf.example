# 面板二诊断工具自己的配置。复制成同目录的 diag.conf 再改；不写进集群的 deploy.env。
# 命令行上的 --containers、--stdout-file、--cluster-dir 优先于这里。

# 面板二的集群目录（默认就是这个）
CLUSTER_DIR=/data/grafana/vllm-pd-grafana-panel2/glm53-1

# 每台节点上 vLLM 的容器名：地址=容器名，一台有几个容器时用分号分开，各台之间用逗号
# 在节点上执行 docker ps --format '{{.Names}} {{.Image}}' 可以看到容器名
VLLM_CONTAINERS=

# vLLM 的标准输出写进文件（启动脚本里 tee 了）、docker logs 看不到时：地址=文件路径
VLLM_STDOUT_FILES=

# monitor 列出更新脚本的 sha256 时用：更新脚本的路径，可以用通配符，几个之间用逗号
UPDATE_SCRIPTS=<用户目录>/vllm-pd-update-v*/vllm_pd_update*filled.py
