{
  "version": 2,
  "config_id": "pd-diag-v3.3-extra-glm53-2026-11-20a",
  "line": {
    "marker": "[PD_DIAG] ",
    "logger": "vllm.v1.metrics.pd_diagnostics",
    "time_format": "iso8601_ms_offset",
    "log_dir": "/var/log/pd-diag",
    "rotate_mib": 256,
    "keep_hours": 12,
    "flush_seconds": 5,
    "selfcheck_seconds": 60,
    "idle_evict_seconds": 120,
    "max_requests": 20000,
    "record_version": 2
  },
  "roles": {
    "by_process_name": [
      {
        "contains": "EngineCore",
        "role": "engine"
      },
      {
        "contains": "Worker",
        "role": "worker"
      },
      {
        "contains": "APIServer",
        "role": "api"
      },
      {
        "contains": "MainProcess",
        "role": "api"
      }
    ],
    "by_event_prefix": [
      {
        "prefix": "worker_summary",
        "role": "worker",
        "from": [
          "engine"
        ]
      },
      {
        "prefix": "pool_task",
        "role": "pool"
      }
    ],
    "keep_tp_rank": [
      0
    ],
    "ranked_roles": [
      "worker",
      "pool"
    ]
  },
  "passthrough": [
    "api_summary",
    {
      "event": "core_summary",
      "where": {
        "scope": "request"
      }
