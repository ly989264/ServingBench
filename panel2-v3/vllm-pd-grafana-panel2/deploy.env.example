# 部署参数。bin/panel2_cluster.sh add 按这份模板写出每个集群的 deploy.env；手工部署时复制成 deploy.env 并改好。
# 标「必改」的要按现场填，其余的一般不用动。
# 名字、端口、目录、UID 这些项：填了就用填的；留空时按 CLUSTER 和 PORT_BASE 派生（scripts/names.py），
# 名字和 UID 加 -<CLUSTER>，标题加（<CLUSTER>），主机端口是 PORT_BASE 加固定偏移。下面每项的注释写了派生出的值（c 代表集群名，B 代表 PORT_BASE）。

# ---- 集群 ----
# 必改：集群名，只用小写字母、数字和 -。同一台监控机上每个集群一个，不能重复。
CLUSTER=
# 必改：Grafana 里的模型文件夹名，比如 GLM-5.3。同一模型的几个集群放在同一个文件夹里。
MODEL_GROUP=
# 主机端口基数：ClickHouse 用 B，拉取程序用 B+1，本集群面板一的 Prometheus 用 B+2。add 自动分配（18100 起，每个集群 10 个）。
PORT_BASE=
# 总目录：本集群在监控机上的目录（集群目录、TIMING_HOME、拉取镜像）都放在它下面。add 写入（--root、注册表里的或 $HOME），装好以后不要改。
VLLM_PD_ROOT=

# ---- 密码（必改）----
# ClickHouse 管理员密码、Vector 写入用的密码、Grafana 读取用的密码。三个都自己定，只用字母和数字。
CH_ADMIN_PASSWORD=change-me-admin
CH_WRITER_PASSWORD=change-me-writer
CH_READER_PASSWORD=change-me-reader

# ---- 监控机和拉取 ----
# 必改：监控机（面板一的 Grafana 机器）的 IP。Prometheus 用它访问拉取程序的状态。
MONITOR_HOST=10.0.3.2
# 监控机 SSH 到节点用的用户，留空时是当前用户。要能免密登录，不需要 root。
SSH_USER=
# 额外的 ssh 参数，比如 -p 2222 -i /root/.ssh/mykey。一般留空。
SSH_OPTS=
# 节点上 rsync 不在 PATH 里时写它的路径，比如 /opt/rsync/bin/rsync。一般留空。
RSYNC_PATH=
# 多久拉一次（秒）。
PULL_INTERVAL_S=10
# 同时最多拉几台。
PULL_CONCURRENCY=16
# 单台一次拉取的超时（秒）。
PULL_TIMEOUT_S=300
# 拉到监控机的哪里，写绝对路径。留空时放在 CLICKHOUSE_DATA_DIR/pull，CLICKHOUSE_DATA_DIR 也空时放在 TIMING_HOME/pull。
# 这里是各节点日志目录的镜像，占用等于各节点保留的日志之和（下面的 NODE_LOG_KEEP_HOURS，默认 12 小时）。
PULL_DIR=
# 预检时要求镜像目录所在盘的剩余空间（GB）。按全集群 100 请求/秒、节点保留 12 小时估算约 190 GB。
PULL_MIN_DISK_GB=200
# 拉取程序的状态端口，Prometheus 从这里抓。留空时是 B+1。
PULLER_METRICS_PORT=
# rsync 的写法。--append：只传新增的部分，最省，要求日志轮转时用新文件名，写完不改名。
# 真实日志只能 x.log -> x.log.1 这样改名轮转时写 --inplace，每轮要校验整个活动文件。
PULL_RSYNC_FLAGS=--append
# 采集器容器。留空时是 vllm-pd-vector-c。
CENTRAL_CONTAINER=
CENTRAL_IMAGE=timberio/vector:0.61.0-debian
# 采集器容器 docker run 的附加参数，一般留空。比如 --memory 300m 限内存（docker 要支持 cgroup 内存限制）。
CENTRAL_DOCKER_ARGS=

# ---- ClickHouse ----
# ClickHouse 的主机端口（容器里是 8123）。留空时是 B。
CLICKHOUSE_HTTP_PORT=
# ClickHouse 容器。留空时是 vllm-pd-clickhouse-c；数据卷跟着它叫 <容器名>-data、<容器名>-logs。
CLICKHOUSE_CONTAINER=
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.36.3
# 只有 bin/check_cpu.sh 说要用兼容版时才填：兼容版二进制文件的绝对路径。
CLICKHOUSE_COMPAT_BINARY=
# ClickHouse 的数据放在哪。留空时放在 docker 的数据卷里；要放到大盘上就写绝对路径，比如 /data/vllm-clickhouse-c。
# 每个集群的目录都要不同，预检会查。
CLICKHOUSE_DATA_DIR=
# 预检时要求的数据盘剩余空间（GB）。按全集群 100 请求/秒估算：事件表 15 天约 390 GB，汇总表 30 天约 250 GB，
# 拉取镜像 12 小时约 190 GB，合计约 830 GB；这里取约 1.2 倍。请求率不同时按比例换算（教程「磁盘」一节）。
CLICKHOUSE_MIN_DISK_GB=1000
# 保留天数。请求级事件表（逐个事件回溯一个请求）和汇总表（看板和单请求 JSON）。改了之后执行 bin/apply_segments.sh 生效。
EVENT_TTL_DAYS=15
SUMMARY_TTL_DAYS=30
# docker run 的附加参数，一般留空。
CLICKHOUSE_DOCKER_ARGS=
# ClickHouse 自己的内存上限（MiB），写进它的配置 max_server_memory_usage。留空时 ClickHouse 按整台机器的内存定上限。
# 同一台机器装几个集群时给每个集群设一个，不要小于 1500（教程「同一台监控机装几个集群」）。改了以后执行 bin/clickhouse_up.sh，
# ClickHouse 自己重新读配置，不用重启；整项留空（去掉上限）时要再重启 ClickHouse 容器。
CLICKHOUSE_MAX_SERVER_MEMORY_MB=

# ---- 共用的 Grafana，和本集群面板一的 Prometheus ----
# 下面四项和 DOCKER_NETWORK 是这台监控机上所有集群共用的；add 从已装集群的 deploy.env 读（--env-from 指定）。
# 必改：Grafana 的管理员密码（面板一步骤 27 定的）。要能建数据源，所以是 Admin 角色的账号。
GRAFANA_PASSWORD=change-me-grafana
GRAFANA_USER=admin
GRAFANA_URL=http://localhost:3000
GRAFANA_CONTAINER=vllm-pd-grafana
# 本集群面板一的 Prometheus。留空时：地址 http://localhost:<B+2>，容器 vllm-pd-prometheus-c，
# 配置文件 ~/vllm-pd-grafana-panel1-c/prometheus/prometheus.yml。
PROMETHEUS_URL=
PROMETHEUS_CONTAINER=
PROMETHEUS_YML=
# 本集群面板一两个看板的 UID，用于页面顶部的跳转。留空时是 vllm-pd-prefill-c 和 vllm-pd-decode-c。
PANEL1_P_UID=
PANEL1_D_UID=
# 面板一的容器网络，Grafana 所在的那个。ClickHouse 和采集器也加入这个网络。
DOCKER_NETWORK=vllm-pd-monitor
# 采集器和 Grafana 访问 ClickHouse 用的地址。留空时是 ClickHouse 的容器名（同一台机器）；
# ClickHouse 放在别的机器时改成那台机器的 IP。
CLICKHOUSE_ADDR=

# ---- Grafana 和 Prometheus 里本集群的名字，一般留空 ----
# 数据源：UID vllm-pd-clickhouse-c，名字 vLLM ClickHouse（c）。
GRAFANA_DS_UID=
GRAFANA_DS_NAME=
# 看板：UID vllm-pd-request-c，标题「面板二：请求时延拆解（P / D）（c）」。放在 MODEL_GROUP 文件夹里。GRAFANA_BOARD_TITLE 填了就用填的标题，不加后缀。
GRAFANA_BOARD_UID=
GRAFANA_BOARD_TITLE=
# 两张分布表的「有值 / 请求」列：1 显示，留空隐藏。用 bin/has_value.sh show | hide 改，它会重新导入看板。
BOARD_HAS_VALUE=
# 看板上不显示的对照行（segments.json 里 compare 的段 id，逗号分隔），例如 kv_wait_vllm,first_step_vllm,rest_vllm。只影响看板，采集和入库不变。
BOARD_OMIT_SEGMENTS=
# prometheus.yml 里标记段的名字（# BEGIN vllm-timing (面板二 c)），两个抓取任务 vllm-timing-puller-c、vllm-timing-central-c，
# 规则文件 /prometheus/vllm-timing-rules-c.yml 和规则组 vllm-timing-c。
PROMETHEUS_MARK=
PULLER_JOB=
CENTRAL_JOB=
RULES_FILE=
RULES_GROUP=
# SSH 连接复用目录的前缀（临时目录下的 vllm-ssh-c-XXXXXXXX）。
SSH_SOCKET_PREFIX=

# ---- 节点（P、D 所在机器）----
# 运行环境，二选一：
#   mock  内网，没有推理模型。节点上跑 mock 写入程序，它加载下发的三个文件，按当前时间写日志。
#   vllm  模型推理环境。节点上跑打了 pd032 补丁的 vLLM，启动脚本按 bin/nodes.sh paths 的输出加环境变量和挂载。
NODE_MODE=mock
# 必改（vllm 时）：三个节点文件在节点宿主机上的目录，监控机下发到这里。SSH 用户要能写；vllm 时把它挂进 vLLM 容器。
# $HOME 指 SSH 用户在节点上的家目录。
NODE_CONF_DIR=$HOME/vllm-pd-diag/conf
# 必改（vllm 时）：[PD_DIAG] 日志在节点宿主机上的目录，监控机从这里拉。vllm 时是挂进容器的日志目录在宿主机上的那一端。
NODE_LOG_DIR=$HOME/vllm-pd-diag/logs
# vllm 时：三个文件在容器里的路径，VLLM_LOGGING_CONFIG_PATH 和 PYTHONPATH 指向这里。必须是 NODE_CONF_DIR 在容器里看到的路径，
# 三个文件放在一起。留空时等于 NODE_CONF_DIR（容器把宿主机目录按同一路径映射进去，比如 -v /data:/data，就不用另加挂载）。
NODE_CONF_DIR_IN_CONTAINER=
# vllm 时：过滤器在容器里写日志的目录，即 NODE_LOG_DIR 在容器里看到的路径；写进集群目录里 segments.json 的 line.log_dir，
# 升级、回滚都不会改回默认值。留空时等于 NODE_LOG_DIR。
NODE_LOG_DIR_IN_CONTAINER=
# 节点上的过滤器保留日志文件的小时数，超过的文件由过滤器自己删掉；镜像目录按同样的时长保留。留空时是 12。
# 改了以后执行 bin/apply_segments.sh：值写进集群目录里 segments.json 的 line.keep_hours，再下发到节点，过滤器自己重读，
# 不用重启 vLLM。升级、回滚都不会改回默认值。不要直接改 segments.json 里的这个值，下一次 apply_segments.sh 会换回这里的值。
NODE_LOG_KEEP_HOURS=
# vllm 时：每台机器上 vLLM 的容器名，地址=容器名，一台有几个容器时用分号分开，各台之间用逗号，比如 10.0.3.11=vllm-p。
# 留空时 bin/diag.sh 和节点自检在每台上自己找（命令含 vllm serve 的容器），找到的名字写在输出里，请核对。
NODE_VLLM_CONTAINERS=
# vllm 时：启动脚本把 vLLM 的标准输出 tee 进文件、docker logs 看不到时，地址=文件路径。留空时只看 docker logs。
NODE_VLLM_STDOUT_FILES=
# vllm 时：容器里跑 vLLM 的用户的 uid（docker exec <容器> id -u）。填了以后节点自检会检查这个用户能不能读三个文件、写日志目录。
NODE_CONTAINER_UID=
# vllm 时：vLLM 的镜像名。填了以后节点自检会在这个镜像的一次性容器（docker run --rm）里再检查一遍挂载和权限。
NODE_SELFCHECK_IMAGE=
# 预检时要求节点日志目录所在盘的剩余空间（GB）。按全集群 100 请求/秒估算，一台 D 机器（16 个实例）约 65 GB/天，保留 12 小时约 32 GB。
NODE_MIN_DISK_GB=50
# 工作目录，不需要 root。节点上放 mock 写入程序和它的状态，留空时是节点上的 $HOME/vllm-timing（一台节点只属于一个集群）；
# 监控机上放拉取程序的状态，留空时是 $HOME/vllm-timing-c。
TIMING_HOME=
# Python 3.9 及以上。留空时自动找：先找 PATH 里的，都没有就用离线包里自带的。要指定某一个时写绝对路径。
PYTHON=

# ---- mock 写入程序（NODE_MODE=mock）----
# 全集群每秒多少个请求。每个 D 实例的负担 = MOCK_RATE ÷ D 实例总数，超过 1.5 时检查报 FAIL（一个 D 稳定上限约 1.7–2.3）。
# 留空时等于 D 实例总数，即每个 D 每秒 1 个请求。改了之后执行 bin/nodes.sh start 生效。
MOCK_RATE=
# 每台机器要一样，这样各台写出的是同一批请求。
MOCK_SEED=20261111
# P 写几个 TP rank 的行（只有 rank 0 被留下，其余的由过滤器丢掉）。
MOCK_P_RANKS=2
# full：连 vLLM 每步写的快照行一起生成再丢掉，最接近真实；core：只生成过滤器要读的行，省 CPU。
MOCK_STEP_EVENTS=full
# 把这台机器的墙钟偏移这么多秒写进日志，演练时钟差。一般留空。
MOCK_CLOCK_OFFSET_S=

# ---- v3.1-extra：段定义和两个可选的来源 ----
# 段定义：留空时用包里的 segments.json（读同事现有日志时和 v3 相同）；填 profiles/ 下的目录名时用那一份，
# 比如 dsv41 用 profiles/dsv41/segments.json（dsv4.1 打了新补丁以后的段定义）。改了以后重跑 bin/panel2_cluster.sh add。
SEGMENTS_PROFILE=
# proxy 每个请求一行（proxy 补丁，PD_PROXY_DIAG=1）：1 时拉取程序连 PROXY_MACHINE，拉 PROXY_LOG_DIR；0 或留空时不拉，
# 两个 P/D LB proxy 段为空，其余照常。改了以后执行 bin/puller.sh restart。
PROXY_COLLECT=0
# proxy 所在机器，写法和清单里的节点机器相同（SSH 用同一个 SSH_USER、SSH_OPTS）。
PROXY_MACHINE=
# proxy 机器上的日志目录（宿主机路径），即 proxy 的 PD_PROXY_DIAG_DIR 在宿主机上看到的路径。
PROXY_LOG_DIR=
# Mooncake 自己的计时行（Mooncake 补丁 04，[BatchPutTiming]）：1 时拉取程序从 MOONCAKE_LOG_FILES 只取这种行，
# 和缓存池的保存任务对上，填 put 下的 3 段；0 或留空时不取，这 3 段为空。改了以后执行 bin/puller.sh restart。
MOONCAKE_LOG_COLLECT=0
# vLLM 标准错误的去处，地址=来源，一台有几个来源时用分号分开，各台之间用逗号。来源三种写法：
#   /宿主机上的路径（可用通配符）   exec:容器名:/容器里的路径（经 docker exec 读）   logs:容器名（docker logs）
# 比如 10.0.1.1=/data/logs/vllm_dp*.log,10.0.1.2=exec:vllm-p:/workspace/logs/*.log
# 后两种来源要求 SSH_USER 在节点上有 docker 权限。
MOONCAKE_LOG_FILES=
# 计时行的线程号对不上时是否兜底。0 或留空：只按线程号配，不兜底。环境检测结果的 glog= 是 0.7 及以上时设 1：
# 一次调用的线程一行都没有时，同一台机器上时间、key 数对得上的行正好剩一行才配上。改了以后执行 bin/puller.sh restart。
MOONCAKE_TID_FALLBACK=0

# ---- 拉取的来源，一般不用改 ----
# 节点上要拉的目录，写绝对路径，逗号分隔。留空时是 NODE_LOG_DIR。
LOG_DIRS=
# 拉哪些文件，逗号分隔的文件名模式。
LOG_INCLUDE=*.log
